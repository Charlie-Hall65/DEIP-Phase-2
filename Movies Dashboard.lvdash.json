    {
      "name": "de3cda85",
      "displayName": "Movies Cleaned Data Overview Summary",
      "queryLines": [
        "\n",
        "  SELECT\n",
        "  rating,\n",
        "  ROUND(AVG(\n",
        "    CASE \n",
        "      WHEN lasted = 'present' THEN YEAR(CURRENT_DATE()) - CAST(start_year AS INT)\n",
        "      ELSE TRY_CAST(lasted AS DOUBLE)\n",
        "    END\n",
        "  ), 2) as avg_lasted\n",
        "FROM\n",
        "  dbacademy.default.movies_cleaned\n",
        "WHERE\n",
        "  rating IS NOT NULL\n",
        "  AND lasted IS NOT NULL\n",
        "  AND lasted != ''\n",
        "  AND (lasted = 'present' OR TRY_CAST(lasted AS DOUBLE) IS NOT NULL)\n",
        "GROUP BY\n",
        "  rating"
      ]
    }
  ],
